class Solution {
    public String countAndSay(int n) {
        StringBuilder res=new StringBuilder("1");
        for(int i=2;i<=n;i++){
            StringBuilder curr=new StringBuilder();
            int count=1;
            int j;
            for(j=1;j<res.length();j++){
                if(res.charAt(j)==res.charAt(j-1))
                    count++;
                else{
                    curr.append(count).append(res.charAt(j-1));
                    count=1;
                }
            }
            curr.append(count);
            curr.append(res.charAt(j-1));
            res.setLength(0);
            res.append(curr);
            
        }
        return res.toString();
    }
}
